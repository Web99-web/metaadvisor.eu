{{- $lang := site.Language.Lang -}}
{{- $imageRepairRegistry := readFile "migration/verified-url-repairs.json" | transform.Unmarshal -}}
{{- $imageRepairs := $imageRepairRegistry.image_format_aliases -}}
{{- $pages := where site.RegularPages "Type" "news" -}}
{{- $pages = where $pages ".Lang" $lang -}}
{{- $pages = partial "preferred-articles.html" $pages -}}
[
{{- $first := true -}}
{{- range $pg := $pages -}}
  {{- if not $first }},{{ end -}}{{- $first = false -}}
  {{- $ph := "/images/placeholder-metaadvisor-small.jpg" -}}
  {{- $src := "" -}}

  {{/* 1) hero* iz bundlea */}}
  {{ with (or ($pg.Resources.GetMatch "hero.png") ($pg.Resources.GetMatch "hero*")) }}{{ $src = .RelPermalink }}{{ end }}

  {{/* 2) .Params.image_url ili .Params.image (samo lokalni put) */}}
  {{ if not $src }}
    {{ $img := $pg.Params.image_url | default $pg.Params.image }}
    {{ if $img }}
      {{ if hasPrefix $img "/" }}
        {{ $src = $img }}
      {{ else if not (hasPrefix $img "http") }}
        {{ with $pg.Resources.GetMatch $img }}
          {{ $src = .RelPermalink }}
        {{ else }}
          {{ $src = printf "/images/%s" $img }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}

  {{ if not $src }}{{ $src = $ph }}{{ end }}
  {{/* Only the audited, explicitly verified JSON image aliases are repaired. */}}
  {{ if in $imageRepairRegistry.json_image_keys $src }}
    {{ $verified := index $imageRepairRegistry.images $src }}
    {{ if and $verified (fileExists (printf "static%s" (urls.Parse $verified).Path)) }}
      {{ $src = $verified }}
    {{ else }}
      {{ errorf "Verified JSON image target missing for %s: %s" $pg.RelPermalink $src }}
    {{ end }}
  {{ end }}
  {{/* Resolve only approved image-format migrations; preserve every other record. */}}
  {{ if not (fileExists (printf "static%s" (urls.Parse $src).Path)) }}
    {{ with index $imageRepairs $src }}
      {{ if fileExists (printf "static%s" (urls.Parse .).Path) }}{{ $src = . }}{{ end }}
    {{ end }}
  {{ end }}

  {
    "title": {{ $pg.Title | jsonify }},
    "url": {{ $pg.RelPermalink | jsonify }},
    "date": {{ $pg.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ $pg.Summary | plainify | jsonify }},
    "image": {{ $src | jsonify }},
    "tags": {{ $pg.Params.tags | default (slice) | jsonify }}
  }
{{- end -}}
]
